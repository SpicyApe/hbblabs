# Payment gateway (see src/lib/payments/index.ts)
# Nothing here is read yet — MockPaymentProvider ignores all of it.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Database (see src/lib/db/index.ts)
# Currently unused; carts and orders live in memory. Product catalog reads
# come from WooCommerce (see WOOCOMMERCE_URL below), not this.
DATABASE_URL=

# WooCommerce Store API (see src/lib/woocommerce.ts)
# The WordPress/WooCommerce install the product catalog is read from. Must be
# a different host to the storefront itself: WordPress keeps hbb-labs.com,
# this app is served from shop.hbb-labs.com.
# Defaults to https://hbb-labs.com if unset.
WOOCOMMERCE_URL=https://hbb-labs.com

# Public site URL, used for canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
