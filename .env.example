# Medusa backend (see src/lib/medusa.ts)
# The commerce backend the catalog and carts come from. Locally this is the
# Medusa app in ../hercules-medusa; in production it is wherever that is
# deployed. It must be a different host to the storefront itself.
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable key from Medusa. It scopes requests to a sales channel and is
# safe to expose — it grants no write access beyond a visitor's own cart.
# Find it in the Medusa admin under Settings -> Publishable API keys.
MEDUSA_PUBLISHABLE_KEY=

# Currency the storefront prices in. The region is resolved by matching this
# rather than by id, since region ids differ between environments.
MEDUSA_CURRENCY=usd

# Payment gateway (see src/lib/payments/index.ts)
# Nothing here is read yet — MockPaymentProvider ignores all of it.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Database (see src/lib/db/index.ts)
# Unused by the storefront: Medusa owns the catalog and carts, and has its
# own database. Only the order scaffold would need this.
DATABASE_URL=

# Public site URL, used for canonical metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
